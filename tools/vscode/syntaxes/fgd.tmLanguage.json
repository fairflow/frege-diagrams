{
  "scopeName": "source.fgd",
  "name": "Figure language",
  "comment": "Generated by docs/tools/grammar.py --textmate; do not edit.",
  "patterns": [
    {
      "name": "comment.line.double-dash.fgd",
      "match": "--(?!\\[).*$"
    },
    {
      "name": "string.quoted.double.fgd",
      "match": "\"[^\"]*\""
    },
    {
      "name": "keyword.operator.labelled.fgd",
      "match": "-\\[[^\\]]*\\]->?"
    },
    {
      "match": "\\b(fig)\\s+([^\\s\\[=]+)",
      "captures": {
        "1": {
          "name": "keyword.other.fig.fgd"
        },
        "2": {
          "name": "entity.name.function.fgd"
        }
      }
    },
    {
      "name": "keyword.control.fgd",
      "match": "\\b(default|then|all|not|ex|if)\\b"
    },
    {
      "name": "support.function.hint.fgd",
      "match": "\\b(definition|judgement|content|italic|middle|namedy|stroke|black|claim|label|morse|notch|route|views|bend|dash|down|edge|grey|loop|side|size|text|gap|red|at|up)\\b"
    },
    {
      "name": "keyword.operator.relation.fgd",
      "match": "<=|~>|!=|°|;|\\bR\\b|="
    },
    {
      "name": "keyword.operator.logical.fgd",
      "match": "[&|]"
    },
    {
      "name": "constant.numeric.fgd",
      "match": "-?\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  ]
}
