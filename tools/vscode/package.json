{
  "name": "frege-diagrams",
  "displayName": "Frege Diagrams",
  "description": "Edit Frege-style formula trees and Kripke frame pictures, drawn by Lean, inside VS Code.",
  "version": "0.12.0",
  "publisher": "fairflow",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fairflow/frege-diagrams"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lean4",
    "onLanguage:fgd",
    "workspaceContains:**/*.fgd"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fgd",
        "aliases": [
          "Figure language",
          "fgd"
        ],
        "extensions": [
          ".fgd"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "fregeDiagrams.figureEditor",
        "displayName": "Frege Diagrams: figure editor",
        "selector": [
          {
            "filenamePattern": "*.fgd"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Frege Diagrams",
      "properties": {
        "fregeDiagrams.framediagPath": {
          "type": "string",
          "default": "",
          "description": "The framediag program to use. Empty: the one the workspace's Lake build makes (.lake/packages/frege-diagrams/.lake/build/bin/framediag, or .lake/build/bin/framediag in frege-diagrams itself)."
        },
        "fregeDiagrams.lakePath": {
          "type": "string",
          "default": "",
          "description": "The lake program used to build framediag when it is missing. Empty: ~/.elan/bin/lake, else lake on the PATH."
        }
      }
    },
    "commands": [
      {
        "command": "fregeDiagrams.editFigures",
        "title": "Edit figures (the first figure string of this Lean file)",
        "category": "Frege Diagrams"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fregeDiagrams.editFigures",
          "when": "resourceExtname == .lean"
        }
      ]
    },
    "grammars": [
      {
        "language": "fgd",
        "scopeName": "source.fgd",
        "path": "./syntaxes/fgd.tmLanguage.json"
      },
      {
        "scopeName": "fgd.injection.lean",
        "path": "./syntaxes/fgd-in-lean.tmLanguage.json",
        "injectTo": [
          "source.lean4"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.fgd": "fgd"
        }
      }
    ]
  },
  "scripts": {
    "prepare-package": "node scripts/prepare.js",
    "package": "node scripts/prepare.js && npx --yes @vscode/vsce@3.2.1 package --no-dependencies --out frege-diagrams.vsix",
    "test": "node test/smoke.js",
    "test:vscode": "node test/integration/run.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.4.1"
  }
}
